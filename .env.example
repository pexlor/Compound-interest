# SQLite is always the application database. Leave MYSQL_DSN empty for SQLite only.
MYSQL_DSN=

# Optional docker compose -p fulibu --profile mysql-backup up --build -d
# Fill these with different randomly generated passwords before enabling the profile.
MYSQL_BACKUP_PASSWORD=
MYSQL_BACKUP_ROOT_PASSWORD=

# Set MYSQL_DSN using the same MYSQL_BACKUP_PASSWORD, for example:
# MYSQL_DSN=fulibu_backup:YOUR_PASSWORD@tcp(mysql:3306)/fulibu_backup
# For an existing server, replace mysql:3306 and fulibu_backup with your target.
# Use an empty, dedicated MySQL database. Do not commit your real .env file.
